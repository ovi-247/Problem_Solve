
class Student extends Person {

    private int[] marks;

    public Student(String firstName, String lastName, int idNumber, int[] marks) {
        super(firstName, lastName, idNumber);
        this.marks = marks;
    }

    public char calculate() {

        int total = 0;

        for (int index = 0; index < marks.length; index++) {
            total += marks[index];
        }

        int avg = total / marks.length;

        if (avg >= 90) {
            return 'O';
        } else if (avg >= 80) {
            return 'E';
        } else if (avg >= 70) {
            return 'A';
        } else if (avg >= 55) {
            return 'P';
        } else if (avg >= 40) {
            return 'D';
        } else {
            return 'T';
        }
    }
}
